{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Auth.Api 5100/5101",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build Auth.Api",
            "program": "${workspaceFolder}/Auth/Auth.Api/bin/Debug/net9.0/Auth.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Auth/Auth.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "uriFormat": "%s/swagger",
                "action": "openExternally",
                "pattern": "Now listening on: (https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_URLS": "http://localhost:5100;https://localhost:5101"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
